# Poste.io Mail Server — environment variable reference
# Copy relevant lines to a .env file alongside docker-compose.yaml

# Timezone
TZ=America/New_York

# Hostname / domain — your mail server's fully-qualified domain name
BASE_HOST_NAME=${HOSTNAME}
BASE_DOMAIN_NAME=example.com

# Disable HTTPS redirect (set to OFF when behind reverse proxy)
# Options: OFF | ON
HTTPS=OFF

# ClamAV antivirus (resource-intensive; disable on low-memory hosts)
DISABLE_CLAMAV=TRUE

# Rspamd spam filter
DISABLE_RSPAMD=FALSE
