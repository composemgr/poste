# poste.io — environment variable reference
# Copy this file to app.env and adjust as needed.

# Timezone
TZ=America/New_York

# Hostname / domain
BASE_HOST_NAME=poste.example.com
BASE_DOMAIN_NAME=example.com

# TLS handling — set to ON when the app terminates TLS itself
HTTPS=OFF

# Bundled scanners — ClamAV is memory intensive
DISABLE_CLAMAV=TRUE
DISABLE_RSPAMD=FALSE
